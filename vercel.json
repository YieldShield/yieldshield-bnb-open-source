{
  "rewrites": [
    {
      "source": "/api/markets",
      "destination": "https://base-api.yieldshield.ai/api/markets"
    },
    {
      "source": "/((?!api/).*)",
      "destination": {
        "service": "web"
      }
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        }
      ]
    }
  ],
  "services": {
    "web": {
      "buildCommand": "npm run build",
      "outputDirectory": "apps/web/dist",
      "framework": "vite",
      "root": ".",
      "rewrites": [
        {
          "source": "/(.*)",
          "destination": "/index.html"
        }
      ]
    }
  }
}
